{
  "name": "proxymailer/sdk",
  "description": "Official ProxyMailer PHP SDK",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/webxspark-devs/proxy-mailer",
  "support": {
    "docs": "https://github.com/webxspark-devs/proxy-mailer/tree/main/docs/developers",
    "source": "https://github.com/webxspark-devs/proxy-mailer/tree/main/sdks/php",
    "issues": "https://github.com/webxspark-devs/proxy-mailer/issues"
  },
  "keywords": ["proxymailer", "email", "smtp", "sdk", "api"],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0",
    "php-http/discovery": "^1.19"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "guzzlehttp/guzzle": "^7.8",
    "php-http/guzzle7-adapter": "^1.0",
    "php-http/mock-client": "^1.6",
    "nyholm/psr7": "^1.8",
    "guzzlehttp/psr7": "^2.6"
  },
  "autoload": {
    "psr-4": { "ProxyMailer\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ProxyMailer\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "suggest": {
    "guzzlehttp/guzzle": "PSR-18 HTTP client used by default so request timeouts are enforced",
    "nyholm/psr7": "PSR-17 factories used when none are injected"
  }
}
